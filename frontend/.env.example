# Copy to `.env` locally. Never commit real values.

HOST=127.0.0.1
PORT=3888

# Talk
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=api
AI_API_FORMAT=openai
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_API_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_EFFORT=medium

# Voice
TTS_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_SPEED=1
DEEPGRAM_TTS_PAUSE_MS=500

# Pictures (Wikimedia first, then OpenAI Images)
OPENAI_IMAGE_MODEL=

# Supabase (browser = URL + anon/publishable; ECS also needs service role)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Cartesia TTS
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-3.5
