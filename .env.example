# ─── AI Provider ───────────────────────────────────────────
AI_PROVIDER=api
AI_API_FORMAT=openai
AI_API_URL=https://api.openai.com/v1
AI_API_MODEL=gpt-4o
AI_API_KEY=sk-...
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Primer Talk ───────────────────────────────────────────
PRIMER_TALK_MODEL=gpt-4o
PRIMER_TALK=true
AI_EFFORT=medium

# ─── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── TTS ──────────────────────────────────────────────────
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=aura-2-theia-en
DEEPGRAM_TTS_SPEED=1.05
DEEPGRAM_TTS_PAUSE_MS=250
DEEPGRAM_API_KEY=

# ─── Cartesia (alternative TTS) ──────────────────────────
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Groq ─────────────────────────────────────────────────
