{
  "name": "zawvee-platform",
  "version": "2.0.0",
  "description": "Zawvee — Full-stack AI Learning Platform (Next.js Frontend + FastAPI Backend)",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue.bold,magenta.bold\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": ".venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8000 --reload",
    "build": "npm --prefix frontend run build",
    "check": "npm --prefix frontend run check"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
